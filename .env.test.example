# Copy to .env.test. The test suite truncates every table before each test
# file and refuses to run unless the database name ends in "_test".
DATABASE_URL=postgres://finance@localhost:5432/finance_test

# 32 bytes, hex encoded. Generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Signs the session cookie. 32 bytes, hex encoded. Generate: openssl rand -hex 32
SESSION_SECRET=

# tests/auth.test.ts exercises checkPassword() against this.
APP_PASSWORD=test-password

# Plaid dashboard -> Keys. Use the sandbox secret first, production later.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox            # sandbox | production
PLAID_COUNTRY_CODES=US
PLAID_PRODUCTS=transactions

# Postgres. docker-compose sets this for the app container.
DATABASE_URL=postgres://finance:finance@localhost:5432/finance

# 32 bytes, hex encoded. Generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Password for the single user login.
APP_PASSWORD=

# Shared secret for the cron caller of /api/sync. Generate: openssl rand -hex 24
SYNC_SECRET=

# Public URL of the app (used for the Plaid webhook, optional).
APP_URL=http://localhost:3000
